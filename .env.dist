# Database Credentials
DB_USERNAME=""
DB_PASSWORD=""
DB_DATABASE=""

# Database Connection Info
DB_HOSTNAME=127.0.0.1
DB_CHARSET="utf8mb4"
DB_COLLATION="utf8mb4_unicode_ci"

# Declare the concrete5 environment (This makes /application/config/"live".database.php work)
CONCRETE5_ENV="live"

# define what files and directories should be imported and backuped
FILES=".htaccess,.htpasswd,robots.txt,composer.json,composer.lock,.env,auth.json"
DIRECTORIES="files,config"
