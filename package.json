{
  "name": "innovationsbox",
  "description": "A moderated platform for submitting, reviewing, and collaboratively developing climate-relevant project ideas",
  "license": "MIT",
  "homepage": "https://github.com/lemonbrain-GmbH/Innovationsbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemonbrain-GmbH/Innovationsbox.git"
  },
  "scripts": {
    "development": "mix",
    "watch": "mix watch",
    "watch-poll": "mix watch -- --watch-options-poll=1000",
    "hot": "mix watch --hot",
    "production": "mix --production",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "tokens": "node scripts/build-tokens.js",
    "prestorybook": "npm run tokens",
    "storybook": "concurrently \"php -S 0.0.0.0:6007 storybook-server/index.php\" \"storybook dev -p 6006 --no-open --host 0.0.0.0\"",
    "storybook:build": "npm run tokens && storybook build",
    "lint": "eslint resources/js/ --ext .ts",
    "lint:fix": "eslint resources/js/ --ext .ts --fix",
    "lint:scss": "stylelint 'resources/**/*.scss' 'public/packages/inno_frontend/components/**/*.scss'",
    "lint:scss:fix": "stylelint 'resources/**/*.scss' 'public/packages/inno_frontend/components/**/*.scss' --fix",
    "format": "prettier --check 'resources/**/*.{ts,js,json}'",
    "format:fix": "prettier --write 'resources/**/*.{ts,js,json}'",
    "typecheck": "tsc --noEmit",
    "lint:api": "spectral lint docs/api/openapi.yaml",
    "lint:all": "npm run lint && npm run format && npm run lint:scss && npm run typecheck && npm run lint:api",
    "test:ci": "bash scripts/ci-test.sh",
    "playwright:install": "playwright install chromium",
    "prepare": "husky",
    "audit:sast": "semgrep --config=auto --error resources/js/ public/packages/inno_*/src/ storybook-server/",
    "audit:npm": "better-npm-audit audit --level high",
    "license:check": "npx license-checker --production --failOn 'GPL-3.0;AGPL-3.0'"
  },
  "dependencies": {
    "@concretecms/bedrock": "^1.1.3",
    "@fancyapps/ui": "^4.0.31",
    "dompurify": "^3.4.7",
    "mapbox-gl": "^2.12.1",
    "normalize.css": "^8.0.1",
    "swipe-detect": "^1.0.1",
    "ts-debounce": "^4.0.0",
    "ts-loader": "^9.4.2",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@stoplight/spectral-cli": "^6.15.1",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-links": "^8.6.18",
    "@storybook/server": "^8.6.18",
    "@storybook/server-webpack5": "^8.6.18",
    "@types/dompurify": "^3.0.5",
    "@types/mapbox-gl": "^2.7.10",
    "better-npm-audit": "^3.11.0",
    "browser-sync": "^3.0.4",
    "browser-sync-webpack-plugin": "^2.3.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "laravel-mix": "^6.0.49",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.57.1",
    "sass-loader": "^12.6.0",
    "storybook": "^8.6.18",
    "stylelint": "^17.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript-eslint": "^8.58.2",
    "webpack-cli": "^5.0.1"
  }
}
