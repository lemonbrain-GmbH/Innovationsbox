{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "noImplicitAny": true,
    "sourceMap": false,
    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["resources/js/types/*"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["resources/js/**/*", "public/packages/inno_frontend/components/**/*"],
  "exclude": ["node_modules"]
}
