# The source path. The location your project files are located.
# This variable is only relevant for the C5 CLI
# e.g. /root (~)
# This will be where you want your files and directories to be copied to, inside the backup directory.
# A backup directory named e.g. 202205041226 the datetime formatted yyyymmddhhmm will be created in this TARGET_PATH. So your directoriy will be here: /root/202205041226
SOURCE_PATH=/var/www/html/bankavera/bkp

# Putting it into .env file allows more control.
# Rarely, you may need to add the whole of the application diretory due to some packages creating or copying files to application directories
# Add a list of files ina a string
# IMPORTANT: a list of files and directories are separated with a comman, no space
FILES=.htaccess,robots.txt,composer.json,composer.lock,.env,auth.json
DIRECTORIES=files,config

# Project specific
# Please set here the version your concreteCMS Project is using. So the backup can been easily installed.

# Concrete CMS specific v8 or v9
# Install project using command `composer create concrete5/composer` from https://packagist.org/packages/concrete5/composer
# Please check this website page for reference.
# If blank the version will take the most recent which at time of writing (04.05.2022) is v1.3.0
# v1.3.0 uses concrete5/core: ^9.0.1
# v1.2.0 uses concrete5/core: ^8.2
C5_VERSION=v1.2.0

# For Git configuration
# Please set here the git user credentials which your concreteCMS Project is using. So the backup can been easily installed.

# These credentials are needed if git has to be installed.
# Details are used to configure the Git username and email. These details will then be associated with created commits
GIT_USER_FIRST_NAME=Marco
GIT_USER_LAST_NAME=Kuoni
GIT_USER_EMAIL=marco@lemonbrain.ch